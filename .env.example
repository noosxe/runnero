# ==============================================================================
# All-in-One Multi-Provider Runner Supervisor Configuration
# ==============================================================================

# Required: 256-bit encryption key (minimum 32 bytes) for AES-256 database
# encryption and HKDF-derived JWT session signing.
# Generate with: openssl rand -base64 32
SUPERVISOR_DB_ENCRYPTION_KEY=

# HTTP port exposed on the host for the Web UI and ConnectRPC API (default: 8090)
SUPERVISOR_PORT=8090

# Logging verbosity: debug | info | warn | error (default: info)
SUPERVISOR_LOG_LEVEL=info

# Endpoint of the host Docker daemon for spawning runner containers
SUPERVISOR_DOCKER_HOST=unix:///var/run/docker.sock

# Persistent data directory inside the supervisor container (default: /data)
SUPERVISOR_DATA_DIR=/data

# SQLite automated snapshot backup interval in hours (default: 6)
SUPERVISOR_BACKUP_INTERVAL_HOURS=6

# Number of rolling SQLite backup snapshots to retain (default: 7)
SUPERVISOR_BACKUP_RETENTION_COUNT=7

# Enforce Secure flag on session cookies (set to true behind HTTPS reverse proxy)
SUPERVISOR_SECURE_COOKIE=false

# Query the forge once per job completion for the runner's latest concluded job
# (conclusion enrichment on webhookless deployments; docs/21 section 5.3; default: true)
#SUPERVISOR_ENRICH_JOB_CONCLUSIONS=true


# ==============================================================================
# Standalone Static Runner Configuration (Optional / Legacy single-runner)
# Required only if running: docker compose --profile runner-standalone up runner
# ==============================================================================

# The full URL of the GitHub repository (e.g., https://github.com/owner/repo)
GITHUB_REPOSITORY_URL=https://github.com/owner/repo

# Pre-generated runner registration token obtained from repository settings
RUNNER_TOKEN=your_registration_token_here

# Custom name for the runner inside GitHub dashboard
RUNNER_NAME=runner-aio

# Comma-separated list of labels to assign to the runner
RUNNER_LABELS=self-hosted,linux,arm64

# Work directory path inside the container where workflow jobs execute
RUNNER_WORKDIR=_work

# ==============================================================================
# All-in-One Multi-Provider Runner Supervisor Configuration
# ==============================================================================

# Required: 256-bit encryption key (minimum 32 bytes) for AES-256 database
# encryption of credentials at rest.
# Generate with: openssl rand -base64 32
SUPERVISOR_DB_ENCRYPTION_KEY=

# HTTP port exposed on the host for the Web UI and ConnectRPC API (default: 8090)
SUPERVISOR_PORT=8090

# Logging verbosity: debug | info | warn | error (default: info)
SUPERVISOR_LOG_LEVEL=info

# Endpoint of the host Docker daemon for spawning runner containers
SUPERVISOR_DOCKER_HOST=unix:///var/run/docker.sock

# Cross-instance engine safety (RUN-241, docs/33 section 3.5). strict (the
# default) refuses to stop or drain runners this database has no ownership
# evidence for - the guard that keeps a second supervisor instance sharing
# this Docker engine from destroying your runners. adopt-all is a ONE-SHOT
# escape hatch for genuine orphan takeover (wiped/restored data dir, moved
# engine): it treats every managed container as owned, disables the guard,
# and logs a prominent boot warning. Boot once with it, then remove it.
#SUPERVISOR_ENGINE_OWNERSHIP=strict
# Persistent data directory inside the supervisor container (default: /data)
SUPERVISOR_DATA_DIR=/data

# SQLite automated snapshot backup interval in hours (default: 6)
SUPERVISOR_BACKUP_INTERVAL_HOURS=6

# Number of rolling SQLite backup snapshots to retain (default: 7)
SUPERVISOR_BACKUP_RETENTION_COUNT=7


# Durable log persistence (RUN-186, docs/28): mirrors the structured log
# stream into boot files under <data-dir>/logs/supervisor/, persists runner
# captures and removal records in <data-dir>/logs, and sweeps retention.
# All knobs have safe defaults; log-persistence-enabled=false disables every
# durable artifact (stdout behavior never changes).
SUPERVISOR_LOG_PERSISTENCE_ENABLED=true
#SUPERVISOR_LOG_SUPERVISOR_ROTATION_BYTES=33554432
#SUPERVISOR_LOG_SUPERVISOR_MAX_FILES=10
#SUPERVISOR_LOG_RUNNER_CAPTURE_MAX_BYTES=16777216
#SUPERVISOR_LOG_RUNNER_CAPTURE_TIMEOUT_SECONDS=10
#SUPERVISOR_LOG_RUNNER_MAX_FILES=200
#SUPERVISOR_LOG_TOTAL_BUDGET_BYTES=1073741824
# Session cookie Secure attribute mode: auto (HTTPS requests only, default),
# always (HTTPS-only deployments behind a TLS proxy), never (plain-HTTP LAN).
SUPERVISOR_SECURE_COOKIES=auto
# Deprecated legacy boolean, still honored: true maps to "always".
SUPERVISOR_SECURE_COOKIE=false
# Sliding idle timeout: sessions unused this long are deleted (default 168h = 7 days)
#SUPERVISOR_SESSION_IDLE_TIMEOUT=168h
# Absolute session lifetime cap, fixed at login and never extended (default 720h = 30 days);
# must not be shorter than the idle timeout.
#SUPERVISOR_SESSION_ABSOLUTE_TIMEOUT=720h
# Bcrypt cost for new or changed passwords, 4-31 (default 12)
#SUPERVISOR_BCRYPT_COST=12
# Audit log purge horizon applied by the hourly maintenance sweep
# (default 2160h = 90 days)
#SUPERVISOR_AUDIT_RETENTION=2160h
# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy for client-IP
# extraction and Secure=auto HTTPS detection (default: false)
#SUPERVISOR_TRUSTED_PROXY=false
# Passkey (WebAuthn) login (docs/34): the Relying Party ID is the effective
# domain the UI is served under (Tailscale MagicDNS name or reverse-proxy
# domain). Empty keeps passkeys completely off. Use a stable hostname, NOT an
# IP (browsers refuse WebAuthn on IP origins); 'localhost' works for local dev.
#SUPERVISOR_WEBAUTHN_RP_ID=
# Allowed ceremony origins (CSV); defaults to https://<webauthn-rp-id>.
# Set explicitly for non-443 ports or extra origins, e.g.
# https://runnero.tailnet-xyz.ts.net,http://localhost:8090
#SUPERVISOR_WEBAUTHN_ORIGINS=

# Query the forge once per job completion for the runner's latest concluded job
# (conclusion enrichment on webhookless deployments; docs/21 section 5.3; default: true)
#SUPERVISOR_ENRICH_JOB_CONCLUSIONS=true

# Webhook receiver: real-time autoscaling via provider webhooks (docs/03 §4).
# Set the shared HMAC secret for each provider whose webhooks the supervisor
# should accept; leave unset to keep that provider's /hooks/<provider>
# endpoint disabled. Rotation requires a supervisor restart.
SUPERVISOR_WEBHOOK_GITHUB_SECRET=
SUPERVISOR_WEBHOOK_GITEA_SECRET=
SUPERVISOR_WEBHOOK_FORGEJO_SECRET=

# Embedded Tailscale (docs/26): off unless the auth key is set. Use a tagged,
# reusable key (tag:runnero); see the README Tailscale section for the one-time
# tailnet prerequisites (MagicDNS, HTTPS, funnel nodeAttr). Requires outbound
# UDP + TCP 443 only; no inbound ports are published.
SUPERVISOR_TAILSCALE_AUTHKEY=
#SUPERVISOR_TAILSCALE_HOSTNAME=runnero
#SUPERVISOR_TAILSCALE_FUNNEL=true
#SUPERVISOR_TAILSCALE_UI=true
#SUPERVISOR_TAILSCALE_STATE_DIR=

# ==============================================================================
# Standalone Static Runner Configuration (Optional / Legacy single-runner)
# Required only if running: docker compose --profile runner-standalone up runner
# ==============================================================================

# The full URL of the GitHub repository (e.g., https://github.com/owner/repo)
GITHUB_REPOSITORY_URL=https://github.com/owner/repo

# Pre-generated runner registration token obtained from repository settings
RUNNER_TOKEN=your_registration_token_here

# Custom name for the runner inside GitHub dashboard
RUNNER_NAME=runner-aio

# Comma-separated list of labels to assign to the runner
RUNNER_LABELS=self-hosted,linux,arm64

# Work directory path inside the container where workflow jobs execute
RUNNER_WORKDIR=_work
